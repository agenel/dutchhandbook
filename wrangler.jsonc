{
  // Cloudflare Workers + Static Assets config for the More Dutch frontend.
  // `npx wrangler deploy` uploads the Angular build (assets) plus the small
  // Worker below, which reverse-proxies /api/* to the Render API so the browser
  // stays same-origin (required for the cookie + CSRF auth).
  "name": "moredutch",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-06",
  "assets": {
    "binding": "ASSETS",
    "directory": "apps/web/dist/web/browser",
    // Serve index.html (the client-only app shell) for routes that aren't
    // prerendered: account pages and unknown URLs (the app shows its 404 page).
    "not_found_handling": "single-page-application",
    // Prerendered pages live at <route>/index.html. Serve them at the
    // slash-less URL the app uses (/tools/quiz) instead of 307-redirecting to /tools/quiz/.
    "html_handling": "drop-trailing-slash",
    // Run the Worker first for /api/* (proxy) and "/" (serves the prerendered
    // home from /_home/; see worker/index.js). Everything else is static.
    "run_worker_first": ["/api/*", "/"]
  }
}
